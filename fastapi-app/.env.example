# =============================================================================
# 智能地块提取平台 · 后端环境变量（全部可被「系统配置」页面覆盖并热生效）
# 这里只是冷启动默认值；页面里改过的值以数据库为准。
# =============================================================================

# ---------- 服务 ----------
APP_HOST=0.0.0.0
APP_PORT=9090
APP_SECRET_KEY=change-me-in-production-please
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 业务库（账号/配置/知识库元数据/对话记录） ----------
# 默认 SQLite，零依赖可直接跑；生产可切 MySQL：
# mysql://root:password@127.0.0.1:3306/plot_sys
SYS_DB_URL=sqlite:///.data/sys.db

# ---------- 空间库（PostgreSQL + PostGIS + pgvector） ----------
# 留空或连不上时自动降级到本地引擎（Shapely 空间计算 + 本地向量检索）
POSTGRES_DSN=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/plot_gis
# 本地降级引擎的数据文件（相对 fastapi-app 目录）
LOCAL_GIS_URL=sqlite:///.data/gis_local.db

# ---------- 大模型（OpenAI 兼容协议，切换 base_url 即换厂商） ----------
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_CHAT_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_MAX_STEPS=8

# ---------- 嵌入模型 / RAG ----------
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=text-embedding-v3
EMBED_DIM=1024
RAG_TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# ---------- 天地图 ----------
TIANDITU_TOKEN=
TIANDITU_USE_SK=false
TIANDITU_SK=

# ---------- 星图云 GEOVIS ----------
GEOVIS_TOKEN=

# ---------- 提取参数 ----------
EXTRACT_GRID_SIZE=300
EXTRACT_SIMPLIFY=0.0001
EXTRACT_MIN_AREA_MU=0
EXTRACT_DEFAULT_CENTER=116.397,39.908
EXTRACT_DEFAULT_EXTENT_KM=3
